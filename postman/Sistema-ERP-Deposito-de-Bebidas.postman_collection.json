              "raw": "{\n  \"fornecedorId\": {{fornecedorId}},\n  \"numeroFatura\": \"AVULSO-001\",\n  \"numeroParcela\": 1,\n  \"dataEmissao\": \"2026-08-06\",\n  \"valorAPagar\": 150.00,\n  \"dataVencimento\": \"2026-09-05\",\n  \"descricao\": \"Frete extra\"\n}"
            },
