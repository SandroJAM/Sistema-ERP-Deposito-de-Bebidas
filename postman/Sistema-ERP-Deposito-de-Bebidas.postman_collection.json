{
  "info": {
    "name": "Sistema ERP - Depósito de Bebidas",
    "description": "Coleção completa da API do Controle de Vendas / Depósito de Bebidas.\n\nComo usar:\n1. Rode a requisição 'Login' dentro da pasta Auth primeiro — ela salva o token JWT automaticamente na variável {{token}} (veja a aba Scripts > Post-response).\n2. Todas as demais requisições já usam Bearer {{token}} na aba Authorization, herdado da collection.\n3. Ajuste a variável {{baseUrl}} se o backend não estiver em localhost:8080 (ex: acessando por IP na rede local).\n4. As rotas marcadas com (admin) exigem um usuário com perfil ADMIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "clienteId", "value": "1" },
    { "key": "produtoId", "value": "1" },
    { "key": "categoriaId", "value": "1" },
    { "key": "fornecedorId", "value": "1" },
    { "key": "notaEntradaId", "value": "1" },
    { "key": "pagamentoId", "value": "1" },
    { "key": "vendaId", "value": "1" },
    { "key": "usuarioId", "value": "1" },
    { "key": "empresaId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const dados = pm.response.json();",
                  "    pm.collectionVariables.set('token', dados.token);",
                  "    console.log('Token salvo em {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@deposito.com\",\n  \"senha\": \"troque-esta-senha\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Autentica e devolve o token JWT. O script de teste salva o token em {{token}} automaticamente para as demais requisições."
          }
        }
      ]
    },
    {
      "name": "Empresa",
      "item": [
        {
          "name": "Listar empresas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/empresas", "host": ["{{baseUrl}}"], "path": ["empresas"] }
          }
        },
        {
          "name": "Empresa atual (cabeçalho das telas)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/empresas/atual", "host": ["{{baseUrl}}"], "path": ["empresas", "atual"] },
            "description": "204 sem corpo se ainda não houver nenhuma empresa cadastrada."
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/empresas/{{empresaId}}", "host": ["{{baseUrl}}"], "path": ["empresas", "{{empresaId}}"] }
          }
        },
        {
          "name": "Cadastrar empresa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Depósito de Bebidas do Zé\",\n  \"endereco\": \"Rua das Flores, 123 - Recife/PE\",\n  \"telefone\": \"81 99999-0000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/empresas", "host": ["{{baseUrl}}"], "path": ["empresas"] },
            "description": "Só permite um cadastro por vez — tentar criar um segundo retorna 400 (RegraNegocioException)."
          }
        },
        {
          "name": "Atualizar empresa",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Depósito de Bebidas do Zé\",\n  \"endereco\": \"Rua das Flores, 123 - Recife/PE\",\n  \"telefone\": \"81 99999-0000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/empresas/{{empresaId}}", "host": ["{{baseUrl}}"], "path": ["empresas", "{{empresaId}}"] }
          }
        },
        {
          "name": "Excluir empresa (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/empresas/{{empresaId}}", "host": ["{{baseUrl}}"], "path": ["empresas", "{{empresaId}}"] }
          }
        }
      ]
    },
