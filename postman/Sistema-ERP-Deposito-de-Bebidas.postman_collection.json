    {
      "name": "Vendas",
      "item": [
        {
          "name": "Listar todas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vendas", "host": ["{{baseUrl}}"], "path": ["vendas"] }
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vendas/{{vendaId}}", "host": ["{{baseUrl}}"], "path": ["vendas", "{{vendaId}}"] }
          }
        },
        {
          "name": "Criar venda",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"clienteId\": {{clienteId}},\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/vendas", "host": ["{{baseUrl}}"], "path": ["vendas"] },
            "description": "clienteId é opcional (venda de balcão). O preço unitário é sempre o atual do produto — não enviar precoUnitario. Baixa o estoque automaticamente; a venda nasce com statusPagamento=PENDENTE."
          }
        },
        {
          "name": "Cancelar venda",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/vendas/{{vendaId}}/cancelar", "host": ["{{baseUrl}}"], "path": ["vendas", "{{vendaId}}", "cancelar"] },
            "description": "Devolve o estoque dos itens."
          }
        },
        {
          "name": "Clientes devedores (resumo)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vendas/clientes/devedores", "host": ["{{baseUrl}}"], "path": ["vendas", "clientes", "devedores"] },
            "description": "Um registro por cliente com saldo devedor > 0 — base da tela de Consulta de Vendas."
          }
        },
        {
          "name": "Extrato do cliente (bobina)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vendas/clientes/{{clienteId}}/extrato?somenteDevido=true&inicio=&fim=&statusPagamento=",
              "host": ["{{baseUrl}}"],
              "path": ["vendas", "clientes", "{{clienteId}}", "extrato"],
              "query": [
                { "key": "somenteDevido", "value": "true", "description": "true = ignora período, traz só o que ainda deve" },
                { "key": "inicio", "value": "", "description": "yyyy-MM-dd — só usado quando somenteDevido=false" },
                { "key": "fim", "value": "", "description": "yyyy-MM-dd — só usado quando somenteDevido=false" },
                { "key": "statusPagamento", "value": "", "description": "PENDENTE, PARCIAL ou PAGO (opcional)" }
              ]
            }
          }
        },
        {
          "name": "Extrato do cliente em PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vendas/clientes/{{clienteId}}/extrato/pdf?somenteDevido=true&inicio=&fim=&statusPagamento=",
              "host": ["{{baseUrl}}"],
              "path": ["vendas", "clientes", "{{clienteId}}", "extrato", "pdf"],
              "query": [
                { "key": "somenteDevido", "value": "true" },
                { "key": "inicio", "value": "" },
                { "key": "fim", "value": "" },
                { "key": "statusPagamento", "value": "" }
              ]
            },
            "description": "Mesmos filtros do extrato normal, mas devolve o arquivo PDF (bobina) pra download."
          }
        },
        {
          "name": "Listar recebimentos da venda",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/vendas/{{vendaId}}/recebimentos", "host": ["{{baseUrl}}"], "path": ["vendas", "{{vendaId}}", "recebimentos"] }
          }
        },
        {
          "name": "Registrar recebimento (baixa)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 20.00,\n  \"dataRecebimento\": \"2026-08-06\",\n  \"observacao\": \"Pix\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/vendas/{{vendaId}}/recebimentos", "host": ["{{baseUrl}}"], "path": ["vendas", "{{vendaId}}", "recebimentos"] },
            "description": "Baixa total ou parcial. O valor não pode ultrapassar o saldo devedor da venda; dataRecebimento é opcional (default hoje)."
          }
        }
      ]
    },
    {
      "name": "Usuários (admin)",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] }
