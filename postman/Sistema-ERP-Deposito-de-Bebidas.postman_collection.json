          "name": "Listar",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notas-entrada", "host": ["{{baseUrl}}"], "path": ["notas-entrada"] }
          }
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notas-entrada/{{notaEntradaId}}", "host": ["{{baseUrl}}"], "path": ["notas-entrada", "{{notaEntradaId}}"] }
          }
        },
        {
          "name": "Criar (gera pagamento automaticamente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"NF-00123\",\n  \"fornecedorId\": {{fornecedorId}},\n  \"dataNota\": \"2026-08-01\",\n  \"valorNota\": 900.00,\n  \"vencimento\": \"2026-08-31\",\n  \"numeroParcelas\": 3,\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 200,\n      \"valorUnitario\": 4.50\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/notas-entrada", "host": ["{{baseUrl}}"], "path": ["notas-entrada"] },
            "description": "numeroParcelas > 1 divide o valor em parcelas mensais e gera um Pagamento pra cada uma."
          }
        },
        {
          "name": "Cancelar",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/notas-entrada/{{notaEntradaId}}/cancelar", "host": ["{{baseUrl}}"], "path": ["notas-entrada", "{{notaEntradaId}}", "cancelar"] },
            "description": "Reverte o estoque dos itens e cancela todas as parcelas de pagamento, inclusive as já pagas."
          }
        }
      ]
    },
    {
      "name": "Pagamentos Fornecedor",
      "item": [
        {
          "name": "Listar (todos os filtros opcionais)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pagamentos?notaEntradaId=&fornecedorId=&status=&vencimentoDe=&vencimentoAte=",
              "host": ["{{baseUrl}}"],
              "path": ["pagamentos"],
              "query": [
                { "key": "notaEntradaId", "value": "", "description": "Se informado, ignora os demais filtros" },
                { "key": "fornecedorId", "value": "" },
                { "key": "status", "value": "", "description": "PENDENTE, PAGO ou CANCELADO" },
                { "key": "vencimentoDe", "value": "", "description": "yyyy-MM-dd" },
                { "key": "vencimentoAte", "value": "", "description": "yyyy-MM-dd" }
              ]
            }
          }
        },
        {
          "name": "Buscar por id",
